      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="ASR3 - Modificabilidad (baseline pipeline adapters)" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${ASR3_THREADS}</stringProp>
        <intProp name="ThreadGroup.ramp_time">10</intProp>
