locals {
  common_tags = {
    Project   = "${var.project_prefix}-sprint4"
    ManagedBy = "Terraform"
  }
}

resource "aws_security_group" "ssh" {
  name        = "${var.project_prefix}-sg-ssh"
  description = "Allow SSH from anywhere"

  ingress {
    description = "SSH"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Allow all outbound traffic"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(local.common_tags, { Name = "${var.project_prefix}-sg-ssh" })
}

resource "aws_security_group" "kong" {
  name        = "${var.project_prefix}-sg-kong"
  description = "Allow public traffic to Kong API Gateway on 8000"

  ingress {
    description = "Kong proxy"
    from_port   = 8000
    to_port     = 8000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
