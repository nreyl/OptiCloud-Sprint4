}

resource "aws_security_group" "apps_http" {
  name        = "${var.project_prefix}-sg-apps-http"
  description = "Allow HTTP traffic between services (and from operators) on 3000 and 8080"

  ingress {
    description = "Service HTTP (8080)"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "NestJS HTTP (3000)"
    from_port   = 3000
    to_port     = 3000
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    description = "Allow all outbound traffic"
